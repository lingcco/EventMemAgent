# Copy this file to .env and edit the paths for your machine.
# Relative paths are resolved from the repository root by the release scripts.

# Models
MODEL_PATH=checkpoints/released/EventMemAgent-8B
BASE_MODEL_PATH=checkpoints/pretrained/Qwen3-VL-8B-Instruct
MEMORY_CAPTION_MODEL_PATH=checkpoints/pretrained/Qwen3-VL-4B-Instruct
MEMORY_CAPTION_MODE=http
MEMORY_API_BASE=http://localhost:8000/v1
MEMORY_CAPTION_MODEL_NAME=Qwen3-VL-4B-Instruct
MEMORY_CUDA_VISIBLE_DEVICES=0
EMBEDDING_MODEL_PATH=checkpoints/pretrained/Qwen3-Embedding-0.6B
DETECTION_MODEL_PATH=checkpoints/tools/grounding-dino-base
OCR_MODEL_PATH=checkpoints/tools/DeepSeek-OCR-updated

# Training and evaluation data
TRAIN_DATA=data/train/eventmemagent_train.parquet
# Optional held-out validation parquet. Leave empty for training without validation.
VAL_DATA=
OVOBENCH_DATA=data/eval/ovobench/eventmemagent_ovobench.parquet
OVOBENCH_METADATA=data/eval/ovobench/ovo_bench_new.json
STREAMINGBENCH_DATA=data/eval/streamingbench/questions_real.json
STREAMINGBENCH_PARQUET=data/eval/streamingbench/eventmemagent_streamingbench.parquet

# Runtime. A command-level CUDA_VISIBLE_DEVICES always takes precedence.
TRAIN_CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
EVAL_CUDA_VISIBLE_DEVICES=0
OCR_CUDA_VISIBLE_DEVICES=0
DETECTION_CUDA_VISIBLE_DEVICES=1
NUM_GPUS=8
TRAIN_TENSOR_PARALLEL_SIZE=8
EVAL_TENSOR_PARALLEL_SIZE=1
EVAL_GPU_MEMORY_UTILIZATION=0.8
EVAL_MAX_MODEL_LEN=32768
EVAL_MM_PROCESSOR_CACHE_GB=0
EVAL_MAX_NUM_SEQS=16
TOOL_CONFIG_PATH=configs/tools.yaml
OCR_API_URL=http://localhost:8089/ocr
DETECTION_API_URL=http://localhost:8090/detect
OCR_HEALTH_URL=http://localhost:8089/health
DETECTION_HEALTH_URL=http://localhost:8090/health
SKIP_TOOL_SERVER_CHECK=0

# Checkpoint resume: auto | disable | resume_path
RESUME_MODE=auto
# RESUME_FROM_PATH=runs/train/eventmemagent_qwen3vl_8b/global_step_90

# Outputs
TRAIN_OUTPUT_DIR=runs/train/eventmemagent_qwen3vl_8b
EVAL_OUTPUT_ROOT=runs/eval

# Hugging Face release destinations
HF_DATASET_REPO=lingcco/EventMemAgent
HF_MODEL_REPO=lingcco/EventMemAgent-8B
HF_PRIVATE=0
UPLOAD_TO_HF=0
